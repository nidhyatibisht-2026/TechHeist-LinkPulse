# Copy to backend/.env for local development (docker-compose sets these for you).
DATABASE_URL=postgresql+asyncpg://linkpulse:linkpulse@localhost:5432/linkpulse
# Leave REDIS_URL empty to run without Redis (no cache; clicks logged in-process).
REDIS_URL=redis://localhost:6379/0
# REQUIRED in production: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-change-me
# Public URL of this API: short links look like BASE_URL/abc1234
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
# Set true behind Render/Railway/nginx so the real visitor IP is used.
TRUST_PROXY_HEADERS=false
# Check that destinations respond when validating in the wizard.
CHECK_REACHABILITY=true
CREATE_RATE_LIMIT=30/minute
PASSWORD_RATE_LIMIT=10/10minutes
# Optional: path to MaxMind GeoLite2-Country.mmdb for country analytics/targeting.
GEOIP_DB_PATH=
# Optional: Google Safe Browsing v4 API key.
SAFE_BROWSING_API_KEY=
# Optional: comma-separated extra hostnames that belong to LinkPulse (blocks redirect loops).
OWN_HOSTS=
